# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_NAME="NovaBank Core API"
API_PREFIX="api/v1"

# ==============================================================================
# BASE DE DATOS (POSTGRESQL 16)
# ==============================================================================
# Para entorno local con Docker:
DATABASE_URL="postgresql://postgres:postgres_secure_2026@localhost:5432/novabank_db?schema=public"

# Para despliegues Serverless / Netlify (ej. Neon / Supabase con connection pooling):
# DATABASE_URL="postgresql://user:pass@ep-pooler.us-east-2.aws.neon.tech/novabank_db?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-direct.us-east-2.aws.neon.tech/novabank_db?sslmode=require"

# ==============================================================================
# CACHÉ Y BLOQUEOS (REDIS 7)
# ==============================================================================
# Para entorno local con Docker:
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# Para despliegues Serverless / Netlify (ej. Upstash Redis o Redis Cloud):
# REDIS_URL="rediss://default:token@flowing-redis-12345.upstash.io:6379"

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ==============================================================================
JWT_SECRET="novabank_ultra_secure_jwt_secret_key_2026_xyz987"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="novabank_refresh_secret_key_2026_abc123"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================================================
# RATE LIMITING (THROTTLER)
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
